@model IEnumerable<TransportationsSystem.Models.Booking>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Bookings";
}

<style>
    .card-dark {
        color: #e6eef6 !important;
    }

    .card-dark h4, .card-dark h5, .card-dark h6 {
        color: #fff !important;
    }

    .card-dark .btn {
        color: #fff;
    }

    .booking-card {
        background: linear-gradient(135deg, rgba(17, 24, 39, 0.95) 0%, rgba(31, 41, 55, 0.95) 100%);
        border: 1px solid rgba(124, 58, 237, 0.2);
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        color: #e6eef6 !important;
    }

    .booking-card:hover {
        transform: translateY(-5px);
        border-color: #7c3aed;
        box-shadow: 0 10px 30px rgba(124, 58, 237, 0.3);
    }

    .booking-card strong {
        color: #fff !important;
    }

    .booking-card span, .booking-card div {
        color: #d1d5db !important;
    }

    .booking-card i {
        color: #a855f7;
    }

    .payment-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .payment-unpaid {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444 !important;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .payment-paid {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981 !important;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .trip-type-badge {
        background: rgba(59, 130, 246, 0.2);
        color: #3b82f6 !important;
        border: 1px solid rgba(59, 130, 246, 0.3);
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .payment-amount {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .bg-dark {
        background: rgba(15, 23, 42, 0.9) !important;
        color: #d1d5db !important;
    }

    .text-muted {
        color: #9ca3af !important;
    }

    .text-success {
        color: #34d399 !important;
    }

    .text-danger {
        color: #f87171 !important;
    }

    .text-warning {
        color: #fbbf24 !important;
    }

    .alert-warning {
        background: rgba(251, 191, 36, 0.15) !important;
        color: #fbbf24 !important;
        border-left: 4px solid #f59e0b;
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.15) !important;
        color: #34d399 !important;
        border-left: 4px solid #10b981;
    }

    .alert-info {
        background: rgba(59, 130, 246, 0.15) !important;
        color: #60a5fa !important;
        border-left: 4px solid #3b82f6;
    }
</style>

<div class="card card-dark p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4><i class="fas fa-list-alt me-2"></i>My Bookings</h4>
        <a href="@Url.Action("Create", "Booking")" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>New Booking
        </a>
    </div>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
            <p class="text-muted">You have no bookings yet.</p>
            <a href="@Url.Action("Create", "Booking")" class="btn btn-primary mt-3">
                <i class="fas fa-plus me-2"></i>Create Your First Booking
            </a>
        </div>
    }
    else
    {
        @foreach (var b in Model)
        {
            <div class="booking-card">
                <div class="row">
                    <!-- Left Column: Route & Schedule -->
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="text-primary mb-0">
                                <i class="fas fa-hashtag"></i>@b.id
                            </h5>
                            <span class="badge @(b.status == "APPROVED" ? "bg-success" : 
                                  b.status == "REJECTED" ? "bg-danger" : 
                                  b.status == "CANCELLED" ? "bg-warning" : 
                                  "bg-secondary")">
                                @b.status
                            </span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-map-marker-alt text-success"></i>
                                <strong>From:</strong>
                                <span>@b.origin</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-map-marker-alt text-danger"></i>
                                <strong>To:</strong>
                                <span>@b.destination</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-calendar"></i>
                                <strong>Schedule:</strong>
                                <span>@b.schedule.ToString("MMM dd, yyyy hh:mm tt")</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-bus"></i>
                                <strong>Vehicle:</strong>
                                <span>@b.vehicle_name (Capacity: @b.capacity)</span>
                            </div>
                        </div>

                        @if (b.status == "APPROVED" && !string.IsNullOrEmpty(b.driver_name))
                        {
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-user-circle me-2"></i>
                                <strong>Driver:</strong> @b.driver_name
                                @if (b.driver_status == "PENDING_DRIVER_RESPONSE")
                                {
                                    <div class="mt-2">
                                        <small class="text-warning">
                                            <i class="fas fa-clock"></i> Waiting for driver response
                                        </small>
                                    </div>
                                }
                                else if (b.driver_status == "ACCEPTED")
                                {
                                    <div class="mt-2">
                                        <small class="text-success">
                                            <i class="fas fa-check-circle"></i> Driver accepted your trip!
                                        </small>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Right Column: Payment Information -->
                    <div class="col-md-6">
                        <div class="bg-dark rounded p-3 h-100">
                            <h6 class="text-white mb-3">
                                <i class="fas fa-receipt me-2"></i>Payment Details
                            </h6>
                            
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Trip Type</small>
                                <span class="trip-type-badge">
                                    @if (b.trip_type == "ONE_WAY")
                                    {
                                        <i class="fas fa-arrow-right me-1"></i><text>One Way</text>
                                    }
                                    else if (b.trip_type == "ROUND_TRIP")
                                    {
                                        <i class="fas fa-exchange-alt me-1"></i><text>Round Trip</text>
                                    }
                                    else if (b.trip_type == "DAY_TRIP")
                                    {
                                        <i class="fas fa-calendar-day me-1"></i><text>Day Trip (@b.trip_days day@(b.trip_days > 1 ? "s" : ""))</text>
                                    }
                                </span>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Amount</small>
                                <div class="payment-amount">₱@b.payment_amount.ToString("N2")</div>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Payment Status</small>
                                @if (b.payment_status == "PAID")
                                {
                                    <span class="payment-badge payment-paid">
                                        <i class="fas fa-check-circle"></i>
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="payment-badge payment-unpaid">
                                        <i class="fas fa-exclamation-circle"></i>
                                        Unpaid
                                    </span>
                                }
                            </div>

                            @if (b.payment_status == "UNPAID" && b.status == "APPROVED")
                            {
                                <div class="alert alert-warning mb-0">
                                    <small>
                                        <i class="fas fa-info-circle me-1"></i>
                                        Please prepare ₱@b.payment_amount.ToString("N2") for payment.
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="mt-3 pt-3 border-top border-secondary">
                    <div class="d-flex gap-2 flex-wrap">
                        @if (b.status == "PENDING")
                        {
                            <form method="post" action="@Url.Action("Cancel", "Booking")" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@b.id" />
                                <button type="submit" class="btn btn-sm btn-danger" 
                                        onclick="return confirm('Are you sure you want to cancel this booking?');">
                                    <i class="fas fa-times me-1"></i>Cancel Booking
                                </button>
                            </form>
                        }
                        
                        @if (b.payment_status == "UNPAID" && (b.status == "APPROVED" || b.status == "PENDING"))
                        {
                            <form method="post" action="@Url.Action("MarkAsPaid", "Booking")" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@b.id" />
                                <button type="submit" class="btn btn-sm btn-success" 
                                        onclick="return confirm('Confirm that you have paid ₱@b.payment_amount.ToString("N2")?');">
                                    <i class="fas fa-check-circle me-1"></i>Mark as Paid
                                </button>
                            </form>
                        }

                        <small class="text-muted ms-auto align-self-center">
                            <i class="fas fa-clock"></i> Booked: @b.created_at.ToString("MMM dd, yyyy")
                        </small>
                    </div>
                </div>
            </div>
        }
    }
</div>
