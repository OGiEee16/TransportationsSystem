@model IEnumerable<TransportationsSystem.Models.Booking>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Bookings";
}
<div class="card card-dark p-3">
    <h4>My Bookings</h4>
    @if (!Model.Any())
    {
        <p class="text-muted">You have no bookings yet.</p>
    }
    else
    {
        <div class="table-responsive mt-3">
            <table class="table table-dark-custom w-100">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Vehicle</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Schedule</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>@b.id</td>
                            <td>@b.vehicle_name</td>
                            <td>@b.origin</td>
                            <td>@b.destination</td>
                            <td>@b.schedule.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge @(b.status == "APPROVED" ? "bg-success" : b.status == "REJECTED" ? "bg-danger" : "bg-secondary")">@b.status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
