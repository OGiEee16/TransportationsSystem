@{
    Layout = null;
    var user = User?.Identity?.Name ?? "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Transportation System</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link href="~/Content/site-dark.css" rel="stylesheet" />

    <style>
        /* General */
        body {
            background-color: #1e1e1e;
            color: #f1f1f1;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Sidebar + Main Layout */
        .sidebar {
            width: 240px;
            background-color: #121212;
            color: #f1f1f1;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            z-index: 1000;
        }

        main {
            margin-left: 240px;
            padding: 80px 30px 30px;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
        }

        /* Top Navbar */
        .top-navbar {
            position: fixed;
            top: 0;
            left: 240px;
            right: 0;
            height: 60px;
            background-color: #181818;
            color: #fff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            z-index: 1001;
            transition: left 0.3s ease;
        }

            .top-navbar h5 {
                margin: 0;
                font-weight: 600;
            }

        .toggle-btn {
            background: none;
            border: none;
            color: #fff;
            font-size: 22px; 
        }

        /* Mobile view */
        media (max-width: 768px) {
            .sidebar

        {
            display: none;
        }

        main {
            margin-left: 0;
            padding-top: 70px;
        }

        .top-navbar {
            left: 0;
        }

        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    @Html.Partial("Sidebar")

    <!-- Top Navbar -->
    <header class="top-navbar">
        <div class="d-flex align-items-center">
            <button class="toggle-btn me-3" id="toggleSidebar">
                <i class="fa fa-bars"></i>
            </button>
            <h5>@ViewBag.Title</h5>
        </div>
        <div>
            <span class="me-3"><i class="fa fa-user-circle"></i> @user</span>
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                </form>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-outline-light">Login</a>
            }
        </div>
    </header>

    <!-- Page Content -->
    <main role="main">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Toggle Sidebar (for mobile)
        const toggleBtn = document.getElementById('toggleSidebar');
        const sidebar = document.querySelector('.sidebar');
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', () => {
                sidebar.style.display =
                    (sidebar.style.display === 'none' || sidebar.style.display === '')
                        ? 'block'
                        : 'none';
            });
        }
    </script>
</body>
</html>
