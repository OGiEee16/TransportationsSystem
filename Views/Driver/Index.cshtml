@model IEnumerable<TransportationsSystem.Models.Booking>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Assigned Trips";
}

<style>
    .revenue-card {
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(16, 185, 129, 0.1) 100%);
        border: 1px solid rgba(124, 58, 237, 0.3);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .revenue-card:hover {
        transform: translateY(-5px);
        border-color: #10b981;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
    }

    .revenue-amount {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 10px 0;
    }

    .revenue-label {
        color: #9ca3af;
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .revenue-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #fff;
        margin-bottom: 15px;
    }

    .table-warning {
        background-color: rgba(255, 193, 7, 0.2) !important;
    }

    .table-info {
        background-color: rgba(13, 202, 240, 0.1) !important;
    }

    .table-secondary {
        opacity: 0.6;
    }

    .stat-card {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(124, 58, 237, 0.2);
        border-radius: 12px;
        padding: 20px;
        color: #fff;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: #10b981;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.2);
    }

    .stat-card h6 {
        color: #9ca3af;
        font-size: 0.85rem;
        margin-bottom: 10px;
    }

    .stat-card h3 {
        color: #fff;
        font-size: 2rem;
        margin: 0;
    }
</style>

<div class="card card-dark p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4><i class="fas fa-route me-2"></i>My Assigned Trips</h4>
            <small class="text-muted">Welcome, @ViewBag.DriverName</small>
        </div>
        <div>
            <a href="@Url.Action("MyTrips", "Driver")" class="btn btn-primary btn-sm">
                <i class="fas fa-list me-1"></i>Detailed View
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Revenue Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="revenue-card">
                <div class="revenue-icon">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <div class="revenue-label">Total Earnings</div>
                <div class="revenue-amount">₱@ViewBag.TotalEarnings.ToString("N2")</div>
                <small class="text-success">
                    <i class="fas fa-check-circle"></i> @ViewBag.CompletedTrips Completed Trips
                </small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="revenue-card">
                <div class="revenue-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div class="revenue-label">Pending Earnings</div>
                <div class="revenue-amount" style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    ₱ @ViewBag.PendingEarnings.ToString("N2")
                </div>
                <small class="text-warning">
                    <i class="fas fa-clock"></i> Awaiting Payment
                </small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="revenue-card">
                <div class="revenue-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div class="revenue-label">This Month</div>
                <div class="revenue-amount" style="background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    ₱ @ViewBag.MonthlyEarnings.ToString("N2")
                </div>
                <small class="text-info">
                    <i class="fas fa-chart-line"></i> @DateTime.Now.ToString("MMMM yyyy")
                </small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="revenue-card">
                <div class="revenue-icon" style="background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);">
                    <i class="fas fa-calculator"></i>
                </div>
                <div class="revenue-label">Potential Total</div>
                <div class="revenue-amount" style="background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    ₱ @((ViewBag.TotalEarnings + ViewBag.PendingEarnings).ToString("N2"))
                </div>
                <small class="text-primary">
                    <i class="fas fa-plus-circle"></i> Paid + Pending
                </small>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> You have no assigned trips yet.
        </div>
    }
    else
    {
        <div class="table-responsive mt-3">
            <table class="table table-dark-custom w-100">
                <thead>
                    <tr>
                        <th>Trip #</th>
                        <th>Vehicle</th>
                        <th>Origin</th>
                        <th>Destination</th>
                        <th>Schedule</th>
                        <th>Passenger</th>
                        <th>Payment</th>
                        <th>Assignment Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        var isUpcoming = b.schedule > DateTime.Now;
                        var isPast = b.schedule < DateTime.Now;
                        var isPending = b.driver_status == "PENDING_DRIVER_RESPONSE";
                        var isAccepted = b.driver_status == "ACCEPTED";
                        
                        <tr class="@(isPending ? "table-warning" : isUpcoming && isAccepted ? "table-info" : isPast ? "table-secondary" : "")">
                            <td><strong>#@b.id</strong></td>
                            <td>
                                <div>@b.vehicle_name</div>
                                <small class="text-muted">Capacity: @b.capacity</small>
                            </td>
                            <td>
                                <i class="fas fa-map-marker-alt text-success"></i> @b.origin
                            </td>
                            <td>
                                <i class="fas fa-map-marker-alt text-danger"></i> @b.destination
                            </td>
                            <td>
                                <div>@b.schedule.ToString("MMM dd, yyyy")</div>
                                <small class="text-muted">@b.schedule.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(b.user_full_name))
                                {
                                    <span class="badge bg-secondary">@b.user_full_name</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">User #@b.user_id</span>
                                }
                            </td>
                            <td>
                                <div class="mb-1">
                                    <strong class="text-success">₱ @b.payment_amount.ToString("N2")</strong>
                                </div>
                                @if (b.payment_status == "PAID")
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle"></i> PAID
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-clock"></i> UNPAID
                                    </span>
                                }
                            </td>
                            <td>
                                @if (b.driver_status == "PENDING_DRIVER_RESPONSE")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-clock"></i> Pending Response
                                    </span>
                                }
                                else if (b.driver_status == "ACCEPTED")
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle"></i> Accepted
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not Set</span>
                                }
                            </td>
                            <td>
                                @if (b.driver_status == "PENDING_DRIVER_RESPONSE")
                                {
                                    <form method="post" action="@Url.Action("AcceptAssignment", "Driver")" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@b.id" />
                                        <button type="submit" class="btn btn-sm btn-success me-1" 
                                                onclick="return confirm('Accept this trip?');">
                                            <i class="fas fa-check-circle"></i> Accept
                                        </button>
                                    </form>
                                    <form method="post" action="@Url.Action("DeclineAssignment", "Driver")" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@b.id" />
                                        <button type="submit" class="btn btn-sm btn-danger" 
                                                onclick="return confirm('Decline this trip? It will be reassigned.');">
                                            <i class="fas fa-times-circle"></i> Decline
                                        </button>
                                    </form>
                                }
                                else if (b.driver_status == "ACCEPTED")
                                {
                                    @if (isUpcoming)
                                    {
                                        <span class="badge bg-primary">
                                            <i class="fas fa-hourglass-half"></i> Upcoming
                                        </span>
                                    }
                                    else if (isPast)
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-check-double"></i> Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-calendar-check"></i> Today
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="stat-card">
                        <h6><i class="fas fa-list me-2"></i>Total Assigned</h6>
                        <h3>@Model.Count()</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <h6><i class="fas fa-clock me-2"></i>Pending Response</h6>
                        <h3>@Model.Count(b => b.driver_status == "PENDING_DRIVER_RESPONSE")</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <h6><i class="fas fa-check-circle me-2"></i>Accepted</h6>
                        <h3>@Model.Count(b => b.driver_status == "ACCEPTED")</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <h6><i class="fas fa-calendar-alt me-2"></i>Upcoming</h6>
                        <h3>@Model.Count(b => b.driver_status == "ACCEPTED" && b.schedule > DateTime.Now)</h3>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
