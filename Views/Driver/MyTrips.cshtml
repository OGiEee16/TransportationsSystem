@model IEnumerable<TransportationsSystem.Models.Booking>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Trips";
}

<style>
    .trip-card {
        background: linear-gradient(135deg, rgba(17, 24, 39, 0.95) 0%, rgba(31, 41, 55, 0.95) 100%);
        border: 1px solid rgba(124, 58, 237, 0.2);
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .trip-card:hover {
        transform: translateY(-5px);
        border-color: #7c3aed;
        box-shadow: 0 10px 30px rgba(124, 58, 237, 0.3);
    }

    .trip-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .trip-id {
        font-size: 1.5rem;
        font-weight: 700;
        color: #7c3aed;
    }

    .trip-route {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
    }

    .location {
        flex: 1;
    }

    .location-label {
        font-size: 0.8rem;
        color: #9ca3af;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .location-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #fff;
    }

    .route-arrow {
        color: #7c3aed;
        font-size: 1.5rem;
    }

    .trip-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .detail-item {
        background: rgba(15, 23, 42, 0.6);
        padding: 12px 15px;
        border-radius: 10px;
        border-left: 3px solid #7c3aed;
    }

    .detail-label {
        font-size: 0.75rem;
        color: #9ca3af;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .detail-value {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
    }

    .trip-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .status-pending {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .status-accepted {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status-completed {
        background: rgba(59, 130, 246, 0.2);
        color: #3b82f6;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .btn-action {
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }

    .btn-accept {
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        color: #fff;
    }

    .btn-accept:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(16, 185, 129, 0.4);
        color: #fff;
    }

    .btn-decline {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-decline:hover {
        background: rgba(239, 68, 68, 0.3);
        transform: translateY(-2px);
        color: #ef4444;
    }

    .filter-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .filter-tab {
        padding: 10px 20px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(124, 58, 237, 0.3);
        color: #9ca3af;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
    }

    .filter-tab:hover,
    .filter-tab.active {
        background: rgba(124, 58, 237, 0.2);
        border-color: #7c3aed;
        color: #a855f7;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(168, 85, 247, 0.1) 100%);
        border: 1px solid rgba(124, 58, 237, 0.2);
        border-radius: 16px;
        padding: 25px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        border-color: #7c3aed;
        box-shadow: 0 10px 25px rgba(124, 58, 237, 0.3);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 10px;
    }

    .stat-label {
        color: #9ca3af;
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: rgba(15, 23, 42, 0.6);
        border-radius: 16px;
        border: 2px dashed rgba(124, 58, 237, 0.3);
    }

    .empty-state i {
        font-size: 4rem;
        color: #7c3aed;
        margin-bottom: 20px;
    }

    .empty-state h4 {
        color: #fff;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: #9ca3af;
    }
</style>

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-2">
                <i class="fas fa-route me-2 text-primary"></i>My Trips
            </h3>
            <p class="text-muted mb-0">Manage and track all your assigned trips & earnings</p>
        </div>
        <div>
            <span class="badge bg-primary" style="font-size: 1rem; padding: 10px 20px;">
                <i class="fas fa-user-check me-2"></i>@ViewBag.DriverName
            </span>
        </div>
    </div>

    <!-- Revenue Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(52, 211, 153, 0.15) 100%); border-color: #10b981;">
                <div class="stat-number" style="background: linear-gradient(135deg, #10b981 0%, #34d399 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    PHP @ViewBag.TotalEarnings.ToString("N2")
                </div>
                <div class="stat-label" style="color: #34d399;">
                    <i class="fas fa-wallet me-1"></i>Total Earnings
                </div>
                <small style="color: #6ee7b7; font-size: 0.75rem;">
                    <i class="fas fa-check-circle me-1"></i>@ViewBag.CompletedTrips paid trips
                </small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(252, 211, 77, 0.15) 100%); border-color: #fbbf24;">
                <div class="stat-number" style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    PHP @ViewBag.PendingEarnings.ToString("N2")
                </div>
                <div class="stat-label" style="color: #fbbf24;">
                    <i class="fas fa-clock me-1"></i>Pending Earnings
                </div>
                <small style="color: #fcd34d; font-size: 0.75rem;">
                    <i class="fas fa-hourglass-half me-1"></i>Awaiting payment
                </small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(96, 165, 250, 0.15) 100%); border-color: #3b82f6;">
                <div class="stat-number" style="background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    PHP @ViewBag.MonthlyEarnings.ToString("N2")
                </div>
                <div class="stat-label" style="color: #60a5fa;">
                    <i class="fas fa-calendar-check me-1"></i>This Month
                </div>
                <small style="color: #93c5fd; font-size: 0.75rem;">
                    <i class="fas fa-chart-line me-1"></i>@DateTime.Now.ToString("MMM yyyy")
                </small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.15) 0%, rgba(168, 85, 247, 0.15) 100%); border-color: #7c3aed;">
                <div class="stat-number" style="background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    PHP @((ViewBag.TotalEarnings + ViewBag.PendingEarnings).ToString("N2"))
                </div>
                <div class="stat-label" style="color: #a855f7;">
                    <i class="fas fa-calculator me-1"></i>Potential Total
                </div>
                <small style="color: #c4b5fd; font-size: 0.75rem;">
                    <i class="fas fa-plus-circle me-1"></i>If all paid
                </small>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-road"></i>
            <h4>No Trips Assigned Yet</h4>
            <p>You don't have any assigned trips at the moment. Check back later!</p>
        </div>
    }
    else
    {
        <!-- Statistics -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">@Model.Count()</div>
                <div class="stat-label">Total Trips</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@Model.Count(b => b.driver_status == "PENDING_DRIVER_RESPONSE")</div>
                <div class="stat-label">Pending Response</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@Model.Count(b => b.driver_status == "ACCEPTED")</div>
                <div class="stat-label">Accepted</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@Model.Count(b => b.driver_status == "ACCEPTED" && b.schedule > DateTime.Now)</div>
                <div class="stat-label">Upcoming</div>
            </div>
        </div>

        <!-- Filter Tabs -->
        <div class="filter-tabs">
            <div class="filter-tab active" data-filter="all">
                <i class="fas fa-list me-2"></i>All Trips
            </div>
            <div class="filter-tab" data-filter="pending">
                <i class="fas fa-clock me-2"></i>Pending
            </div>
            <div class="filter-tab" data-filter="accepted">
                <i class="fas fa-check-circle me-2"></i>Accepted
            </div>
            <div class="filter-tab" data-filter="upcoming">
                <i class="fas fa-calendar-alt me-2"></i>Upcoming
            </div>
            <div class="filter-tab" data-filter="completed">
                <i class="fas fa-flag-checkered me-2"></i>Completed
            </div>
        </div>

        <!-- Trips List -->
        <div id="tripsContainer">
            @foreach (var trip in Model.OrderBy(b => b.schedule))
            {
                var isUpcoming = trip.schedule > DateTime.Now;
                var isPast = trip.schedule < DateTime.Now;
                var isPending = trip.driver_status == "PENDING_DRIVER_RESPONSE";
                var isAccepted = trip.driver_status == "ACCEPTED";
                
                var filterClass = "";
                if (isPending) filterClass = "pending";
                else if (isAccepted && isUpcoming) filterClass = "accepted upcoming";
                else if (isAccepted && isPast) filterClass = "accepted completed";

                <div class="trip-card" data-filter="@filterClass">
                    <!-- Trip Header -->
                    <div class="trip-header">
                        <div class="trip-id">
                            <i class="fas fa-hashtag"></i>@trip.id
                        </div>
                        <div>
                            @if (isPending)
                            {
                                <span class="status-badge status-pending">
                                    <i class="fas fa-clock"></i>
                                    Pending Response
                                </span>
                            }
                            else if (isAccepted && isUpcoming)
                            {
                                <span class="status-badge status-accepted">
                                    <i class="fas fa-calendar-check"></i>
                                    Upcoming
                                </span>
                            }
                            else if (isAccepted && isPast)
                            {
                                <span class="status-badge status-completed">
                                    <i class="fas fa-flag-checkered"></i>
                                    Completed
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Trip Route -->
                    <div class="trip-route">
                        <div class="location">
                            <div class="location-label">
                                <i class="fas fa-map-marker-alt text-success me-1"></i>From
                            </div>
                            <div class="location-name">@trip.origin</div>
                        </div>
                        <div class="route-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                        <div class="location">
                            <div class="location-label">
                                <i class="fas fa-map-marker-alt text-danger me-1"></i>To
                            </div>
                            <div class="location-name">@trip.destination</div>
                        </div>
                    </div>

                    <!-- Trip Details -->
                    <div class="trip-details">
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-calendar me-1"></i>Date
                            </div>
                            <div class="detail-value">@trip.schedule.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-clock me-1"></i>Time
                            </div>
                            <div class="detail-value">@trip.schedule.ToString("hh:mm tt")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-bus me-1"></i>Vehicle
                            </div>
                            <div class="detail-value">@trip.vehicle_name</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-users me-1"></i>Capacity
                            </div>
                            <div class="detail-value">@trip.capacity</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-user me-1"></i>Passenger
                            </div>
                            <div class="detail-value">
                                @if (!string.IsNullOrEmpty(trip.user_full_name))
                                {
                                    @trip.user_full_name
                                }
                                else
                                {
                                    <span>User #@trip.user_id</span>
                                }
                            </div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-info-circle me-1"></i>Status
                            </div>
                            <div class="detail-value">@trip.status</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-route me-1"></i>Trip Type
                            </div>
                            <div class="detail-value">
                                @if (trip.trip_type == "ONE_WAY")
                                {
                                    <text>One Way</text>
                                }
                                else if (trip.trip_type == "ROUND_TRIP")
                                {
                                    <text>Round Trip</text>
                                }
                                else if (trip.trip_type == "DAY_TRIP")
                                {
                                    <text>Day Trip (@trip.trip_days day@(trip.trip_days > 1 ? "s" : ""))</text>
                                }
                            </div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-money-bill-wave me-1"></i>Payment
                            </div>
                            <div class="detail-value">
                                PHP @trip.payment_amount.ToString("N2")
                            </div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-credit-card me-1"></i>Payment Status
                            </div>
                            <div class="detail-value">
                                @if (trip.payment_status == "PAID")
                                {
                                    <span class="text-success">
                                        <i class="fas fa-check-circle"></i> PAID
                                    </span>
                                }
                                else
                                {
                                    <span class="text-warning">
                                        <i class="fas fa-exclamation-circle"></i> UNPAID
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Trip Actions -->
                    @if (isPending)
                    {
                        <div class="trip-actions">
                            @if (trip.payment_status == "UNPAID")
                            {
                                <div class="alert alert-warning mb-3">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Payment Required:</strong> Passenger needs to pay PHP @trip.payment_amount.ToString("N2") before accepting this trip.
                                </div>
                            }
                            <form method="post" action="@Url.Action("AcceptAssignment", "Driver")" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@trip.id" />
                                <button type="submit" class="btn btn-action btn-accept" onclick="return confirm('Accept this trip to @trip.destination?');">
                                    <i class="fas fa-check-circle me-2"></i>Accept Trip
                                </button>
                            </form>
                            <form method="post" action="@Url.Action("DeclineAssignment", "Driver")" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@trip.id" />
                                <button type="submit" class="btn btn-action btn-decline" onclick="return confirm('Decline this trip? It will be reassigned to another driver.');">
                                    <i class="fas fa-times-circle me-2"></i>Decline
                                </button>
                            </form>
                        </div>
                    }
                    else if (isAccepted)
                    {
                        @if (trip.payment_status == "UNPAID")
                        {
                            <div class="alert alert-danger">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-exclamation-circle me-2"></i>
                                        <strong>Payment Not Received:</strong> Passenger has not paid PHP @trip.payment_amount.ToString("N2") yet.
                                    </div>
                                    <form method="post" action="@Url.Action("ConfirmPayment", "Driver")" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@trip.id" />
                                        <button type="submit" class="btn btn-sm btn-success" 
                                                onclick="return confirm('Confirm that you have received PHP @trip.payment_amount.ToString("N2") from the passenger?');">
                                            <i class="fas fa-check me-1"></i>Confirm Payment Received
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mb-0">
                                <i class="fas fa-check-circle me-2"></i>
                                @if (isUpcoming)
                                {
                                    <span>You have accepted this trip. Payment confirmed (PHP @trip.payment_amount.ToString("N2")). Prepare for the journey!</span>
                                }
                                else
                                {
                                    <span>Trip completed. Payment received (PHP @trip.payment_amount.ToString("N2")). Thank you for your service!</span>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
</div>

<script>
    // Filter functionality
    document.querySelectorAll('.filter-tab').forEach(tab => {
        tab.addEventListener('click', function () {
            // Update active tab
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            this.classList.add('active');

            // Get filter value
            const filter = this.getAttribute('data-filter');

            // Filter trips
            document.querySelectorAll('.trip-card').forEach(card => {
                const cardFilters = card.getAttribute('data-filter').split(' ');
                
                if (filter === 'all' || cardFilters.includes(filter)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
</script>
