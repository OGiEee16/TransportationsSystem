@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Admin Dashboard";
}
<div class="row">
    <div class="col-md-6">
        <div class="card card-dark p-3 mb-3">
            <h5>Overview</h5>
            <p class="text-muted">Quick summary of bookings, users, and capacity (add stats via controller).</p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-dark p-3 mb-3">
            <h5>Actions</h5>
            <ul class="list-unstyled">
                <li><a class="text-decoration-none" href="@Url.Action("Bookings", "Admin")">Manage bookings</a></li>
            </ul>
        </div>
    </div>
</div>
