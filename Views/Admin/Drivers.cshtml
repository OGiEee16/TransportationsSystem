@model IEnumerable<TransportationsSystem.Models.User>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
 ViewBag.Title = "Manage Drivers";
}

<div class="card card-dark p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
   <h4><i class="fas fa-users me-2 text-primary"></i>Manage Drivers</h4>
            <p class="text-muted mb-0">View and manage all registered drivers in the system</p>
  </div>
        <div>
       <span class="badge bg-primary" style="font-size: 1rem;">
  <i class="fas fa-id-card me-1"></i>Total Drivers: @Model.Count()
         </span>
        </div>
    </div>

    @if (!Model.Any())
    {
      <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>No drivers registered in the system.
        </div>
        <div class="mt-3">
      <p class="text-muted">
             <i class="fas fa-info-circle me-2"></i>
          To add a driver, go to the 
        <a href="@Url.Action("Users", "Admin")" class="text-decoration-none text-warning">User Management</a> 
  page and change a user's role to <strong>DRIVER</strong>.
       </p>
        </div>
    }
    else
    {
        <div class="table-responsive mt-3">
  <table class="table table-dark-custom">
  <thead>
           <tr>
    <th>ID</th>
         <th>Full Name</th>
  <th>Username</th>
       <th>Email</th>
 <th class="text-center">Status</th>
         <th class="text-center">Actions</th>
            </tr>
             </thead>
 <tbody>
        @foreach (var driver in Model)
        {
      <tr>
           <td>@driver.id</td>
  <td>
     <i class="fas fa-id-card text-primary me-2"></i>
     @driver.full_name
   </td>
    <td>@driver.username</td>
    <td>@driver.email</td>
     <td class="text-center">
    <span class="badge bg-success">
    <i class="fas fa-check-circle me-1"></i>Active
  </span>
    </td>
   <td class="text-center">
        <a href="@Url.Action("Users", "Admin")" class="btn btn-sm btn-outline-info" title="Manage in Users">
           <i class="fas fa-cog"></i>
     </a>
     </td>
 </tr>
          }
         </tbody>
          </table>
        </div>

        <div class="mt-4">
            <div class="row g-3">
         <div class="col-md-6">
     <div class="card bg-dark border-secondary p-3">
          <h6 class="mb-2">
      <i class="fas fa-chart-bar text-primary me-2"></i>Driver Statistics
   </h6>
          <ul class="list-unstyled mb-0">
         <li class="mb-1">
    <i class="fas fa-check text-success me-2"></i>
          <strong>Active Drivers:</strong> @Model.Count()
        </li>
            <li class="mb-1">
   <i class="fas fa-calendar text-info me-2"></i>
        <strong>Total Registered:</strong> @Model.Count()
        </li>
     </ul>
                </div>
             </div>
    <div class="col-md-6">
           <div class="card bg-dark border-secondary p-3">
  <h6 class="mb-2">
    <i class="fas fa-info-circle text-info me-2"></i>Quick Info
        </h6>
            <ul class="list-unstyled mb-0">
               <li class="mb-1">
     <i class="fas fa-user-plus text-warning me-2"></i>
   Add drivers via User Management
     </li>
      <li class="mb-1">
  <i class="fas fa-tasks text-primary me-2"></i>
      Assign trips in Manage Bookings
   </li>
           </ul>
     </div>
            </div>
     </div>
        </div>
    }
</div>
