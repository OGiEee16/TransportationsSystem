@model IEnumerable<TransportationsSystem.Models.User>
@{
 Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manage Users";
}

<div class="card card-dark p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
            <h4><i class="fas fa-user-friends me-2"></i>Manage Users</h4>
     <p class="text-muted mb-0">View, edit roles, and manage all system users</p>
        </div>
        <div>
         <span class="badge bg-primary" style="font-size: 1rem;">
      <i class="fas fa-users me-1"></i>Total: @Model.Count()
        </span>
 </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
  <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
  }

 @if (TempData["Error"] != null)
    {
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
  {
        <div class="alert alert-warning">
      <i class="fas fa-exclamation-triangle me-2"></i>No users found in the system.
</div>
    }
    else
    {
        <!-- Filter by Role -->
        <div class="mb-3">
    <div class="btn-group" role="group">
 <button type="button" class="btn btn-outline-light btn-sm filter-btn" data-filter="all">
            <i class="fas fa-users me-1"></i>All (@Model.Count())
         </button>
         <button type="button" class="btn btn-outline-light btn-sm filter-btn" data-filter="ADMIN">
            <i class="fas fa-user-shield me-1"></i>Admins (@Model.Count(u => u.role == "ADMIN"))
        </button>
           <button type="button" class="btn btn-outline-light btn-sm filter-btn" data-filter="DRIVER">
       <i class="fas fa-id-card me-1"></i>Drivers (@Model.Count(u => u.role == "DRIVER"))
              </button>
       <button type="button" class="btn btn-outline-light btn-sm filter-btn" data-filter="USER">
      <i class="fas fa-user me-1"></i>Users (@Model.Count(u => u.role == "USER"))
         </button>
            </div>
     </div>

        <div class="table-responsive">
    <table class="table table-dark-custom" id="usersTable">
     <thead>
               <tr>
         <th>ID</th>
      <th>Full Name</th>
               <th>Username</th>
  <th>Email</th>
              <th>Role</th>
 <th class="text-center">Actions</th>
   </tr>
      </thead>
       <tbody>
  @foreach (var user in Model)
           {
            <tr data-role="@user.role">
  <td>@user.id</td>
               <td>
        <i class="fas @(user.role == "ADMIN" ? "fa-user-shield text-danger" : 
           user.role == "DRIVER" ? "fa-id-card text-primary" : 
          "fa-user text-info") me-2"></i>
           @user.full_name
            </td>
  <td>@user.username</td>
       <td>@user.email</td>
     <td>
            @if (user.role == "ADMIN")
{
   <span class="badge bg-danger">
                <i class="fas fa-shield-alt me-1"></i>ADMIN
  </span>
         }
       else if (user.role == "DRIVER")
           {
         <span class="badge bg-primary">
         <i class="fas fa-car me-1"></i>DRIVER
            </span>
             }
          else
          {
       <span class="badge bg-info">
      <i class="fas fa-user me-1"></i>USER
             </span>
              }
           </td>
           <td class="text-center">
       @if (user.role != "ADMIN")
   {
          <div class="btn-group btn-group-sm" role="group">
    <!-- Change Role Dropdown -->
  <button type="button" class="btn btn-outline-warning dropdown-toggle" data-bs-toggle="dropdown">
     <i class="fas fa-exchange-alt me-1"></i>Change Role
             </button>
    <ul class="dropdown-menu dropdown-menu-dark">
   @if (user.role != "USER")
    {
      <li>
          <form asp-action="UpdateUserRole" method="post" class="d-inline">
   @Html.AntiForgeryToken()
    <input type="hidden" name="userId" value="@user.id" />
      <input type="hidden" name="newRole" value="USER" />
    <button type="submit" class="dropdown-item" onclick="return confirm('Change role to USER?')">
 <i class="fas fa-user me-2"></i>USER
          </button>
              </form>
          </li>
          }
   @if (user.role != "DRIVER")
       {
  <li>
         <form asp-action="UpdateUserRole" method="post" class="d-inline">
  @Html.AntiForgeryToken()
     <input type="hidden" name="userId" value="@user.id" />
            <input type="hidden" name="newRole" value="DRIVER" />
    <button type="submit" class="dropdown-item" onclick="return confirm('Change role to DRIVER?')">
      <i class="fas fa-id-card me-2"></i>DRIVER
       </button>
     </form>
   </li>
      }
     @if (user.role != "ADMIN")
           {
   <li>
        <form asp-action="UpdateUserRole" method="post" class="d-inline">
    @Html.AntiForgeryToken()
         <input type="hidden" name="userId" value="@user.id" />
             <input type="hidden" name="newRole" value="ADMIN" />
       <button type="submit" class="dropdown-item" onclick="return confirm('Change role to ADMIN? This grants full system access!')">
             <i class="fas fa-shield-alt me-2"></i>ADMIN
         </button>
          </form>
       </li>
    }
      </ul>

   <!-- Delete Button -->
       <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal@(user.id)">
           <i class="fas fa-trash"></i>
       </button>
       </div>

   <!-- Delete Confirmation Modal -->
      <div class="modal fade" id="deleteModal@(user.id)" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
             <div class="modal-content bg-dark text-light">
<div class="modal-header border-secondary">
       <h5 class="modal-title">
                <i class="fas fa-exclamation-triangle text-danger me-2"></i>Confirm Delete
  </h5>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
         <div class="modal-body">
            <p>Are you sure you want to delete this user?</p>
   <div class="alert alert-warning">
        <strong>User:</strong> @user.full_name (@user.username)<br />
       <strong>Role:</strong> @user.role
      </div>
 <p class="text-danger mb-0">
                  <i class="fas fa-exclamation-circle me-1"></i>
      This action cannot be undone!
    </p>
         </div>
           <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i>Cancel
                 </button>
              <form asp-action="DeleteUser" method="post" class="d-inline">
 @Html.AntiForgeryToken()
       <input type="hidden" name="userId" value="@user.id" />
       <button type="submit" class="btn btn-danger">
       <i class="fas fa-trash me-1"></i>Delete User
      </button>
      </form>
        </div>
       </div>
      </div>
          </div>
            }
    else
         {
               <span class="badge bg-secondary">
        <i class="fas fa-lock me-1"></i>Protected
          </span>
          }
             </td>
         </tr>
   }
      </tbody>
            </table>
        </div>

        <div class="mt-4 alert alert-info">
  <strong><i class="fas fa-info-circle me-2"></i>Note:</strong>
       <ul class="mb-0 mt-2">
       <li>Admin users cannot be deleted or have their roles changed for security reasons</li>
    <li>Changing a user to DRIVER role will allow them to accept trip assignments</li>
  <li>Changing a user to ADMIN role grants full system access</li>
  </ul>
    </div>
    }
</div>

<script>
    // Filter users by role
    document.querySelectorAll('.filter-btn').forEach(btn => {
     btn.addEventListener('click', function() {
      const filter = this.getAttribute('data-filter');
            const rows = document.querySelectorAll('#usersTable tbody tr');
        
            // Update active button
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
       this.classList.add('active');
            
   // Filter rows
            rows.forEach(row => {
          if (filter === 'all' || row.getAttribute('data-role') === filter) {
 row.style.display = '';
         } else {
         row.style.display = 'none';
   }
        });
        });
    });
    
    // Set initial active state
    document.querySelector('.filter-btn[data-filter="all"]').classList.add('active');
</script>

<style>
    .filter-btn.active {
      background-color: rgba(124, 58, 237, 0.3);
        border-color: #7c3aed;
        color: #fff;
    }
</style>
