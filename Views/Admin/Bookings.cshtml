@model IEnumerable<TransportationsSystem.Models.Booking>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "All Bookings (Admin)";
    var drivers = (IEnumerable<TransportationsSystem.Models.User>)ViewBag.Drivers;
}
<div class="card card-dark p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4>All Bookings</h4>
  <small class="text-muted">Approve or reject pending bookings & assign drivers</small>
    </div>

    @if (TempData["Error"] != null)
    {
<div class="alert alert-danger alert-dismissible fade show">
    @TempData["Error"]
       <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
 }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
@TempData["Success"]
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive mt-3">
  <table class="table table-dark-custom">
  <thead>
  <tr>
      <th>#</th>
    <th>User</th>
       <th>Vehicle</th>
 <th>Origin</th>
     <th>Destination</th>
     <th>Schedule</th>
                <th>Trip Type</th>
                <th>Payment</th>
    <th>Status</th>
     <th>Driver</th>
   <th>Driver Status</th>
    <th>Actions</th>
      </tr>
   </thead>
            <tbody>
     @foreach (var b in Model)
        {
       <tr>
      <td>@b.id</td>
  <td>@b.user_id</td>
  <td>@b.vehicle_name</td>
        <td>@b.origin</td>
     <td>@b.destination</td>
     <td>@b.schedule.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <small>
                        @if (b.trip_type == "ONE_WAY")
                        {
                            <text>One Way</text>
                        }
                        else if (b.trip_type == "ROUND_TRIP")
                        {
                            <text>Round Trip</text>
                        }
                        else if (b.trip_type == "DAY_TRIP")
                        {
                            <text>Day Trip (@b.trip_days d)</text>
                        }
                    </small>
                </td>
                <td>
                    <div>
                        <strong class="text-success">₱@b.payment_amount.ToString("N2")</strong>
                    </div>
                    <small>
                        @if (b.payment_status == "PAID")
                        {
                            <span class="badge bg-success">PAID</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">UNPAID</span>
                        }
                    </small>
                </td>
       <td>
     <span class="badge @(b.status == "APPROVED" ? "bg-success" : 
     b.status == "REJECTED" ? "bg-danger" : 
 b.status == "CANCELLED" ? "bg-warning text-dark" : 
         "bg-secondary")">
      @b.status
   </span>
    </td>
    <td>
      @if (!string.IsNullOrEmpty(b.driver_name))
     {
    <span class="badge bg-info text-dark">@b.driver_name</span>
 }
  else
 {
    <span class="text-muted">—</span>
  }
     </td>
   <td>
  @if (b.driver_id != null)
      {
  @if (b.driver_status == "PENDING_DRIVER_RESPONSE")
 {
    <span class="badge bg-warning text-dark">
   <i class="bi bi-clock-history"></i> Pending
        </span>
 }
  else if (b.driver_status == "ACCEPTED")
        {
    <span class="badge bg-success">
     <i class="bi bi-check-circle"></i> Accepted
 </span>
   }
else if (b.driver_status == "DECLINED")
 {
  <span class="badge bg-danger">
      <i class="bi bi-x-circle"></i> Declined
        </span>
    }
       else
  {
        <span class="text-muted">—</span>
   }
  }
else
    {
    <span class="text-muted">—</span>
       }
 </td>
  <td>
 @if (b.status == "PENDING")
 {
      <form method="post" action="@Url.Action("UpdateBookingStatus","Admin")" style="display:inline">
    @Html.AntiForgeryToken()
  <input type="hidden" name="id" value="@b.id" />
<input type="hidden" name="actionType" value="approve" />
    <button class="btn btn-sm btn-success me-1">Approve</button>
       </form>
    <form method="post" action="@Url.Action("UpdateBookingStatus","Admin")" style="display:inline">
@Html.AntiForgeryToken()
       <input type="hidden" name="id" value="@b.id" />
 <input type="hidden" name="actionType" value="reject" />
        <button class="btn btn-sm btn-danger">Reject</button>
        </form>
   }
   else if (b.status == "APPROVED" && (b.driver_id == null || b.driver_status == "DECLINED"))
   {
 <!-- ✅ Assign Driver Form -->
       <form method="post" action="@Url.Action("AssignDriver","Admin")" class="d-inline-flex align-items-center gap-1">
  @Html.AntiForgeryToken()
 <input type="hidden" name="bookingId" value="@b.id" />
<select name="driverId" class="form-select form-select-sm" style="width: auto;" required>
     <option value="">Select Driver</option>
   @foreach (var driver in drivers)
     {
 <option value="@driver.id">@driver.full_name</option>
       }
       </select>
   <button type="submit" class="btn btn-sm btn-primary">Assign</button>
 </form>
    }
       else
  {
<small class="text-muted">N/A</small>
   }
      </td>
      </tr>
       }
      </tbody>
        </table>
    </div>
</div>
